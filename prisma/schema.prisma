generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VerificationType {
  EMAIL
}

enum RankedRuleset {
  CLASSIC
  NO_LINE_COLORS
  STRICT_SPELLING
  ONE_LIFE
}

enum RankedRunSource {
  FREE_PLAY
  DAILY
  CHALLENGE
  BATTLE
}

enum RankedRunStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum BattleStatus {
  OPEN
  READY
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELED
}

enum PlaylistLaunchMode {
  CASUAL
  RANKED_CLASSIC
  RANKED_RULESET
}

enum PlaylistRunStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}


model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  displayName       String?
  pendingEmail      String?
  passwordHash      String
  emailVerifiedAt   DateTime?
  adFree            Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  uiPreferences     Json?
  progress          Progress[]
  runSessions       RunSession[]
  challengesCreated ChallengeDefinition[]  @relation("ChallengeCreator")
  battlesCreated    Battle[]               @relation("BattleCreator")
  battlesInvited    Battle[]               @relation("BattleOpponent")
  careerState       PlayerCareerState?
  streakState       PlayerStreakState?
  xpLedgerEntries   XpLedgerEntry[]
  licenses          PlayerLicense[]
  badges            PlayerBadge[]
  campaignProgress  CampaignProgress[]
  seasonProgress    SeasonProgress[]
  playlists         Playlist[]
  playlistRuns      PlaylistRun[]
  sessions          Session[]
  verification      VerificationToken[]
  passwordResets    PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String            @id @default(cuid())
  tokenHash String            @unique
  type      VerificationType  @default(EMAIL)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CaptchaChallenge {
  id         String   @id
  answerHash String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Progress {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  citySlug        String
  foundIds        Json
  foundTimestamps Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, citySlug])
}

model MissedGuessInput {
  id              String   @id @default(cuid())
  citySlug        String
  rawInput        String
  normalizedInput String
  suggestions     Json     @default("[]")
  createdAt       DateTime @default(now())

  @@index([citySlug, createdAt])
  @@index([citySlug, normalizedInput])
  @@index([createdAt, id])
}

model DailyChallenge {
  id          String        @id @default(cuid())
  dateKey     String        @unique
  citySlug    String
  cityPath    String
  ruleset     RankedRuleset @default(CLASSIC)
  seed        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runSessions RunSession[]
}

model ChallengeDefinition {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  citySlug    String
  cityPath    String
  ruleset     RankedRuleset @default(CLASSIC)
  seed        String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  creator     User?         @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId   String?
  battles     Battle[]
  runSessions RunSession[]

  @@index([citySlug, active])
  @@index([createdAt])
}

model Battle {
  id            String               @id @default(cuid())
  slug          String               @unique
  inviteToken   String               @unique
  challenge     ChallengeDefinition? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  challengeId   String?
  citySlug      String
  cityPath      String
  ruleset       RankedRuleset        @default(CLASSIC)
  seed          String
  status        BattleStatus         @default(OPEN)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  joinedAt      DateTime?
  expiresAt     DateTime?
  completedAt   DateTime?
  creator       User                 @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId     String
  opponent      User?                @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  opponentId    String?
  creatorRunId  String?
  opponentRunId String?
  winnerUserId  String?
  winnerReason  String?
  runSessions   RunSession[]

  @@index([creatorId, createdAt])
  @@index([opponentId, createdAt])
  @@index([status, expiresAt])
}

model RunSession {
  id                     String               @id @default(cuid())
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  citySlug               String
  cityPath               String
  ruleset                RankedRuleset        @default(CLASSIC)
  sourceType             RankedRunSource      @default(FREE_PLAY)
  status                 RankedRunStatus      @default(ACTIVE)
  seed                   String
  startedAt              DateTime             @default(now())
  firstCorrectAt         DateTime?
  endedAt                DateTime?
  completionPercent      Float                @default(0)
  completionMs           Int?
  first50Ms              Int?
  correctGuessCount      Int                  @default(0)
  correctStationCount    Int                  @default(0)
  wrongGuessCount        Int                  @default(0)
  repeatedGuessCount     Int                  @default(0)
  hintCount              Int                  @default(0)
  revealUsed             Boolean              @default(false)
  rankedEligible         Boolean              @default(true)
  disqualificationReason String?
  xpAwarded              Int                  @default(0)
  countedForStreak       Boolean              @default(false)
  metadataJson           Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  dailyChallenge         DailyChallenge?      @relation(fields: [dailyChallengeId], references: [id], onDelete: SetNull)
  dailyChallengeId       String?
  challenge              ChallengeDefinition? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  challengeId            String?
  battle                 Battle?              @relation(fields: [battleId], references: [id], onDelete: SetNull)
  battleId               String?
  playlistRun            PlaylistRun?         @relation(fields: [playlistRunId], references: [id], onDelete: SetNull)
  playlistRunId          String?
  season                 Season?              @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonId               String?
  xpLedgerEntries        XpLedgerEntry[]

  @@index([userId, createdAt])
  @@index([citySlug, ruleset, completionMs])
  @@index([sourceType, createdAt])
  @@index([dailyChallengeId, rankedEligible, completionMs])
  @@index([challengeId, rankedEligible, completionMs])
  @@index([battleId, rankedEligible, completionMs])
  @@index([playlistRunId, createdAt])
  @@index([seasonId, createdAt])
}

model PlayerCareerState {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @id
  lifetimeXp Int     @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerStreakState {
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @id
  currentStreak   Int      @default(0)
  bestStreak      Int      @default(0)
  lastCountedDate String?
  freezeTokens    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model XpLedgerEntry {
  id          String      @id @default(cuid())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  runSession  RunSession? @relation(fields: [runSessionId], references: [id], onDelete: SetNull)
  runSessionId String?
  season      Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonId    String?
  sourceKey   String
  amount      Int
  summary     String
  metadataJson Json?
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([runSessionId])
  @@index([seasonId, createdAt])
}

model PlayerLicense {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  key         String
  title       String
  description String?
  awardedAt   DateTime @default(now())

  @@unique([userId, key])
}

model PlayerBadge {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  season      Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonId    String?
  key         String
  title       String
  description String?
  awardedAt   DateTime @default(now())

  @@unique([userId, key])
  @@index([seasonId, awardedAt])
}

model Campaign {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String?
  themeColor  String?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  cities      CampaignCity[]
  progress    CampaignProgress[]
}

model CampaignCity {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  citySlug   String
  cityPath   String
  orderIndex Int      @default(0)

  @@unique([campaignId, citySlug])
  @@index([citySlug])
}

model CampaignProgress {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId         String
  completedCitySlugs Json
  progressCount      Int      @default(0)
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, campaignId])
}

model Season {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?
  themeColor  String?
  startDate   DateTime
  endDate     DateTime
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  events      SeasonEvent[]
  progress    SeasonProgress[]
  runSessions RunSession[]
  xpLedgerEntries XpLedgerEntry[]
  badges      PlayerBadge[]
}

model SeasonEvent {
  id          String        @id @default(cuid())
  season      Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId    String
  slug        String
  title       String
  description String?
  eventType   String
  citySlug    String?
  cityPath    String?
  ruleset     RankedRuleset?
  targetCount Int           @default(1)
  rewardXp    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([seasonId, slug])
}

model SeasonProgress {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  season              Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId            String
  seasonXp            Int      @default(0)
  dailyParticipationCount Int  @default(0)
  battleWinCount      Int      @default(0)
  completedEventSlugs Json
  completedEventCount Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, seasonId])
}

model Playlist {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       PlaylistItem[]
  runs        PlaylistRun[]

  @@index([userId, updatedAt])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  citySlug   String
  cityPath   String
  orderIndex Int

  @@unique([playlistId, orderIndex])
}

model PlaylistRun {
  id                  String             @id @default(cuid())
  playlist            Playlist           @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId          String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  mode                PlaylistLaunchMode
  ruleset             RankedRuleset?
  status              PlaylistRunStatus  @default(ACTIVE)
  currentIndex        Int                @default(0)
  completedLegs       Int                @default(0)
  totalLegs           Int                @default(0)
  aggregateCompletionMs Int             @default(0)
  aggregateAccuracy   Float              @default(0)
  lastCompletedCitySlug String?
  startedAt           DateTime           @default(now())
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  runSessions         RunSession[]

  @@index([playlistId, createdAt])
  @@index([userId, updatedAt])
}


// ============================================================
// Research automation — review-queue-centric transit research.
// ============================================================

enum ResearchTrigger {
  SCHEDULED
  MANUAL
  CHAT
}

enum ResearchRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ResearchLane {
  GREEN
  YELLOW
  RED
}

enum ResearchClaimStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ResearchRun {
  id          String            @id @default(cuid())
  trigger     ResearchTrigger   @default(SCHEDULED)
  scope       String?
  citySlugs   String[]
  status      ResearchRunStatus @default(RUNNING)
  summaryJson Json?
  errorLog    String?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?
  createdAt   DateTime          @default(now())
  claims      ResearchClaim[]
  session     ChatSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId   String?

  @@index([status, createdAt])
  @@index([trigger, createdAt])
}

model ResearchClaim {
  id          String              @id @default(cuid())
  run         ResearchRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId       String
  citySlug    String
  claimType   String
  title       String
  summary     String?
  beforeJson  Json?
  afterJson   Json?
  confidence  Float?
  lane        ResearchLane        @default(YELLOW)
  status      ResearchClaimStatus @default(PENDING)
  reviewNotes String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  evidence    ClaimEvidence[]

  @@index([status, lane, createdAt])
  @@index([citySlug, claimType])
  @@index([runId])
}

model ClaimEvidence {
  id          String        @id @default(cuid())
  claim       ResearchClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId     String
  sourceUrl   String
  sourceTitle String?
  sourceDate  DateTime?
  excerpt     String?
  tier        Int           @default(2)
  createdAt   DateTime      @default(now())

  @@index([claimId])
}

model SourceDomain {
  id         String   @id @default(cuid())
  domain     String   @unique
  tier       Int      @default(2)
  trustScore Float    @default(0.5)
  blocked    Boolean  @default(false)
  notes      String?
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  runs      ResearchRun[]

  @@index([createdAt])
}

model ChatMessage {
  id             String      @id @default(cuid())
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  role           ChatRole
  content        String
  structuredJson Json?
  createdAt      DateTime    @default(now())

  @@index([sessionId, createdAt])
}
